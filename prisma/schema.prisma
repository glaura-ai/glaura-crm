// Glaura CRM — internal sales tool.
// Track salon leads → follow up (activities + reminders) → prepare account/demo
// → trigger onboarding engine (creates a disabled Glaura account).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────

enum Role {
  COMMERCIAL
  ADMIN
}

enum Metier {
  COIFFURE
  ESTHETIQUE
  ONGLES
  BARBIER
  SPA
  AUTRE
}

enum SalonType {
  A
  B
  C
  D
}

// Pipeline stages (mockup chips: à visiter → … → signé)
enum SalonStatus {
  A_VISITER
  VISITE_FAITE
  INTERESSE
  A_RELANCER
  PAS_INTERESSE
  SIGNE
}

enum BookingTool {
  PLANITY
  TREATWELL
  ACUITY
  SITE
  NONE
}

enum ActivityType {
  APPEL
  VISIO
  VISITE
  RELANCE
  EMAIL
  DEMO
  NOTE
}

enum LeadSource {
  MANUAL
  AIRTABLE
  IMPORT
}

// Onboarding engine job lifecycle (mirrors the VPS result file).
enum OnboardingStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
  ALREADY_ONBOARDED
}

// ── Models ───────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  image     String?
  role      Role      @default(COMMERCIAL)
  createdAt DateTime  @default(now())
  lastLogin DateTime?

  assignedSalons Salon[]         @relation("AssignedTo")
  activities     Activity[]
  reminders      Reminder[]
  onboardingJobs OnboardingJob[]
}

model Salon {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  metier         Metier      @default(AUTRE)
  type           SalonType?
  arrondissement String?
  address        String?
  lat            Float?
  lng            Float?
  phone          String?
  instagram      String?
  bookingTool    BookingTool @default(NONE)
  bookingUrl     String?
  rating         Float?
  status         SalonStatus @default(A_VISITER)
  notes          String?     @db.Text

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  source      LeadSource @default(MANUAL)
  externalRef String?    @unique // airtable record id / import key

  lastContactedAt DateTime?
  nextActionAt    DateTime? // next planned touch — feeds "à relancer / priorités"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities     Activity[]
  reminders      Reminder[]
  onboardingJobs OnboardingJob[]

  @@index([status])
  @@index([metier])
  @@index([arrondissement])
  @@index([assignedToId])
  @@index([nextActionAt])
}

model Activity {
  id        String       @id @default(cuid())
  salonId   String
  salon     Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ActivityType
  notes     String?      @db.Text
  outcome   String?
  createdAt DateTime     @default(now())

  @@index([salonId, createdAt])
}

model Reminder {
  id        String    @id @default(cuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId    String? // assignee
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  dueAt     DateTime
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, done, dueAt])
  @@index([salonId])
}

model OnboardingJob {
  id            String           @id @default(cuid())
  salonId       String
  salon         Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?            @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  sourceUrl     String
  sourceType    String? // planity | treatwell | acuity | generic
  status        OnboardingStatus @default(QUEUED)

  accountUid    String?
  loginEmail    String?
  loginPassword String? // engine-generated; reveal is audit-logged in UI
  serviceCount  Int?
  agentCount    Int?
  videoCount    Int?
  warnings      Json?
  error         String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([salonId])
}
