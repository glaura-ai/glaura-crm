// Glaura CRM — internal sales tool.
// Track salon leads → follow up (activities + reminders) → prepare account/demo
// → trigger onboarding engine (creates a disabled Glaura account).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────

enum Role {
  COMMERCIAL
  ADMIN
}

enum Metier {
  COIFFURE
  ESTHETIQUE
  ONGLES
  BARBIER
  SPA
  AUTRE
}

enum SalonType {
  A
  B
  C
  D
}

// Pipeline stages (mockup chips: à visiter → … → signé)
enum SalonStatus {
  A_VISITER
  VISITE_FAITE
  INTERESSE
  A_RELANCER
  PAS_INTERESSE
  SIGNE
}

enum BookingTool {
  PLANITY
  TREATWELL
  ACUITY
  SITE
  NONE
}

enum ActivityType {
  APPEL
  VISIO
  VISITE
  RELANCE
  EMAIL
  DEMO
  NOTE
}

enum LeadSource {
  MANUAL
  AIRTABLE
  IMPORT
}

// Onboarding engine job lifecycle (mirrors the VPS result file).
enum OnboardingStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
  ALREADY_ONBOARDED
}

enum EmailJobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum EmailTemplate {
  INTRO
  DEMO_FOLLOW_UP
  RELANCE
  SIGNATURE_NEXT_STEPS
}

// ── Models ───────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  image     String?
  role      Role      @default(COMMERCIAL)
  createdAt DateTime  @default(now())
  lastLogin DateTime?

  assignedSalons Salon[]         @relation("AssignedTo")
  activities     Activity[]
  reminders      Reminder[]
  onboardingJobs OnboardingJob[]
  emailJobs      EmailJob[]
}

model Salon {
  id                 String      @id @default(cuid())
  name               String
  slug               String      @unique
  metier             Metier[]    @default([]) // a salon can span several métiers
  type               SalonType? // deal-size tier: A = biggest deal … D = smallest
  arrondissement     String?
  address            String?
  lat                Float?
  lng                Float?
  phone              String?
  contactName        String?
  contactEmail       String?
  instagram          String?
  bookingTool        BookingTool @default(NONE)
  bookingUrl         String?
  rating             Float?
  status             SalonStatus @default(A_VISITER)
  notes              String?     @db.Text
  objection          String?     @db.Text
  priorityLabel      String?
  leadTemperature    String?
  accountStatusLabel String?
  sourceLabel        String?

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  source            LeadSource @default(MANUAL)
  externalRef       String?    @unique // airtable record id / import key
  airtableBaseId    String?
  airtableTableId   String?
  airtableTableName String?
  airtableRecordUrl String?

  lastContactedAt     DateTime?
  nextActionAt        DateTime? // next planned touch — feeds "à relancer / priorités"
  priorityDate        DateTime? // hand-pinned "priorité du jour" — surfaces on the assignee's dashboard for that day
  signedAt            DateTime?
  activatedAt         DateTime?
  appointmentAt       DateTime?
  clientBaseImported  Boolean   @default(false)
  importedClientCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities     Activity[]
  reminders      Reminder[]
  onboardingJobs OnboardingJob[]
  emailJobs      EmailJob[]

  @@index([status])
  @@index([metier])
  @@index([arrondissement])
  @@index([assignedToId])
  @@index([assignedToId, priorityDate])
  @@index([nextActionAt])
  @@index([airtableBaseId])
}

model Activity {
  id        String       @id @default(cuid())
  salonId   String
  salon     Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ActivityType
  notes     String?      @db.Text
  outcome   String?
  createdAt DateTime     @default(now())

  @@index([salonId, createdAt])
}

model Reminder {
  id        String    @id @default(cuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId    String? // assignee
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  dueAt     DateTime
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, done, dueAt])
  @@index([salonId])
}

model EmailJob {
  id            String  @id @default(cuid())
  salonId       String
  salon         Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  to       String
  from     String?
  template EmailTemplate
  subject  String
  body     String       @db.Text
  status   EmailJobStatus @default(QUEUED)
  attempts Int          @default(0)
  lastError String?     @db.Text
  sentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([salonId, createdAt])
}

model OnboardingJob {
  id            String  @id @default(cuid())
  salonId       String
  salon         Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  sourceUrl  String
  sourceType String? // planity | treatwell | acuity | generic
  status     OnboardingStatus @default(QUEUED)

  // Per-job onboarding overrides (P6 full onboarding): loginEmail, loginPassword,
  // enable, deposit, agentCount, reviewTarget. Null → legacy disabled behavior.
  config Json?

  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  exitCode   Int?
  eventCount Int       @default(0)
  lastEventAt DateTime?

  accountUid    String?
  loginEmail    String?
  loginPassword String? // engine-generated; reveal is audit-logged in UI
  serviceCount  Int?
  agentCount    Int?
  warnings      Json?
  error         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OnboardingJobEvent[]

  @@index([status])
  @@index([salonId])
  @@index([createdAt])
}

model OnboardingJobEvent {
  id        String        @id @default(cuid())
  jobId     String
  job       OnboardingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sequence Int
  stream   String // stdout | stderr | system
  type     String?
  subtype  String?
  level    String?
  text     String? @db.Text
  data     Json?

  createdAt DateTime @default(now())

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
  @@index([type])
}
